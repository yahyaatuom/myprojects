import numpy as np

fake_band = np.array([
    [0.1, 0.4, 0.8, 0.3, 0.2],
    [0.5, 0.9, 0.7, 0.6, 0.1],
    [0.3, 0.8, 0.95, 0.7, 0.4],
    [0.2, 0.5, 0.6, 0.4, 0.2],
    [0.1, 0.2, 0.3, 0.2, 0.1]
])

print('Shape:', fake_band.shape)
print('Min:', fake_band.min())
print('Max:', fake_band.max())
print('Mean:', fake_band.mean().round(3))

veg_mask = fake_band > 0.6
print('\nVegetation mask (True = vegetation):')
print(veg_mask.astype(int))